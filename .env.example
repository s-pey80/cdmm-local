# Telegram API credentials — from my.telegram.org
API_ID=
API_HASH=
TELEGRAM_PHONE=+1xxxxxxxxxx

# Local mlx-whisper model (Apple Silicon, runs via src/transcribe.py). Default is
# large-v3-turbo — best quality-to-speed ratio on Apple Silicon, ~3GB.
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Local sentence-transformers model for semantic search (src/embed.py + mcp_server.py).
# Must match between the two — changing this requires re-running embed.py to
# re-embed everything, since vectors from different models aren't comparable.
EMBED_MODEL=BAAI/bge-large-en-v1.5

# Telegram bot for chat access (src/bot.py) — create one via @BotFather, then
# paste its token here.
CDMM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot (yours, from
# e.g. @userinfobot). Leave empty and the bot will answer ANY Telegram user
# who messages it — not recommended.
CDMM_BOT_ALLOWED_USER_IDS=

# Optional: absolute path to the `claude` CLI binary, if it's not on PATH
# when src/bot.py runs (e.g. under launchd). Defaults to `which claude`.
CLAUDE_BIN=
